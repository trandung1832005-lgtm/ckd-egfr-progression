# Sao chép thành .env (KHÔNG commit .env). Backend tự đọc file này khi chạy cục bộ.
APP_ENV=dev                       # dev | prod  (prod bắt buộc SECRET_KEY >= 32 ký tự và ALLOWED_ORIGINS cụ thể)
SECRET_KEY=                       # prod: chuỗi ngẫu nhiên dài, ví dụ: python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=                     # để trống = SQLite var/app.db (dev). Prod: postgresql://user:pass@host/db
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
SESSION_TTL_HOURS=12
TRUSTED_PROXY_HOPS=0              # 0 = dùng IP kết nối trực tiếp. Vercel->Render: 2
# Gửi email đặt lại mật khẩu / kích hoạt tài khoản (để trống = admin tự chuyển liên kết)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
